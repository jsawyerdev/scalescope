# Copy to .env to override the observe-profile defaults in docker-compose.yml.
# Only needed for `docker compose --profile observe up`; the default DEMO
# service needs none of this.

# Primary Namespace/Deployment. SCALESCOPE_K8S_METRICS_URL and opt-in
# actuation attach to this target.
SCALESCOPE_K8S_NAMESPACE=scalescope-demo
SCALESCOPE_K8S_DEPLOYMENT=sample-workload

# Comma-separated namespace discovery allowlist for OBSERVE mode. Keep this
# aligned with the ServiceAccount's real RBAC scope. Use "*" only when the
# identity is intentionally allowed to inspect all namespaces.
SCALESCOPE_K8S_NAMESPACES=scalescope-demo

# Path on the host to the kubeconfig scripts/generate-observer-kubeconfig.sh
# generated. Never commit the file this points to - it contains a live
# cluster credential.
SCALESCOPE_OBSERVER_KUBECONFIG=./scalescope-observer.kubeconfig

# The observed workload's own /metrics endpoint, reachable from inside the
# container - also where /trigger (the dashboard's load-generator buttons)
# gets POSTed. Prefer a stable address if your cluster can provide one (a
# LoadBalancer Service - `kubectl patch svc $SCALESCOPE_K8S_DEPLOYMENT -n
# $SCALESCOPE_K8S_NAMESPACE -p '{"spec":{"type":"LoadBalancer"}}'`, then use
# its EXTERNAL-IP here) over `kubectl port-forward ... 18080:80` +
# http://host.docker.internal:18080/metrics: the port-forward is a
# foreground/background host process with no supervision - it dies
# silently on sleep/network changes/terminal closure and every metrics
# scrape and /trigger call then fails with no visible cause until you
# notice and restart it.
SCALESCOPE_K8S_METRICS_URL=http://host.docker.internal:18080/metrics

# Set to true to let ScaleScope actually write recommended replica counts
# to the cluster (deployments/scale only). Refuses to write if the target
# Deployment already has a HorizontalPodAutoscaler - remove it first
# (`kubectl delete hpa <name> -n $SCALESCOPE_K8S_NAMESPACE`) or the two
# controllers will fight. See README.md's "Actuation" section.
SCALESCOPE_ACTUATE=false

# Optional per-pod request rates from a Prometheus server. Without them (and
# without SCALESCOPE_K8S_METRICS_URL), each workload is forecast on its total
# CPU usage from metrics-server and sized against its pods' CPU request.
# SCALESCOPE_PROMETHEUS_URL=http://prometheus.example:9090
# The instant query must return series labelled with namespace and pod.
# SCALESCOPE_PROMETHEUS_RPS_QUERY=sum by (namespace, pod) (rate(http_requests_total[2m]))
# The same server also supplies per-pod CPU throttling (cAdvisor), p95 latency
# and 5xx error rate; see README "Run it" for the default queries. Set a query
# to an empty string to skip that signal.
# SCALESCOPE_PROMETHEUS_LATENCY_QUERY=1000 * histogram_quantile(0.95, sum by (namespace, pod, le) (rate(http_request_duration_seconds_bucket[2m])))

# p95 latency target (ms) for sizing pods from the fitted latency curve.
# Unset -> twice the workload's measured no-load latency.
# SCALESCOPE_LATENCY_SLO_MS=250

# Requests/s one pod serves at 100% of its CPU request. Unset -> estimated
# per workload from its own request-rate and CPU history.
# SCALESCOPE_CAPACITY_PER_POD_RPS=150

# How long a new pod takes to serve traffic, including a new node if the
# cluster autoscaler must add one. Pods are started this far ahead.
# SCALESCOPE_POD_STARTUP_SECONDS=30

# Long-memory model: minute history kept, forecast horizon, retrain interval.
# SCALESCOPE_HISTORY_RETENTION_DAYS=35
# SCALESCOPE_LONG_HORIZON_MINUTES=60
# SCALESCOPE_RETRAIN_MINUTES=15

# Replica bounds for every recommendation (and for actuation).
# SCALESCOPE_MIN_REPLICAS=1
# SCALESCOPE_MAX_REPLICAS=30

# Actuation only: hold scale-downs at the highest recommendation of this many
# seconds (the Kubernetes HPA default is 300). 0 relies on the forecast
# horizon alone, which measured cheapest with the same under-provisioning.
# SCALESCOPE_SCALE_DOWN_STABILIZATION_SECONDS=0

# Optional LightGBM tuning config. Run scripts/tune/tune_periodic.sh (or the
# one-shot tuner) first, then opt in with the container path exposed by
# docker-compose.yml's read-only /tune-output mount. Match the file name to
# the workload you tuned; see scripts/tune/README.md.
# SCALESCOPE_LIGHTGBM_CONFIG_PATH=/tune-output/payments-api.json

# HTTP Basic Auth in front of every route (API and dashboard) except
# /healthz, applied to both the DEMO and OBSERVE instances if set here.
# Both unset -> no auth (fine for a local demo or deliberately trusted LAN).
SCALESCOPE_AUTH_USERNAME=
SCALESCOPE_AUTH_PASSWORD=
