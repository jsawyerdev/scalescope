# Copy to .env to override the observe-profile defaults in docker-compose.yml.
# Only needed for `docker compose --profile observe up`; the default DEMO
# service needs none of this.

# Namespace/Deployment scripts/generate-observer-kubeconfig.sh's identity
# is scoped to (must match what k8s/rbac/ was applied for).
SCALESCOPE_K8S_NAMESPACE=scalescope-demo
SCALESCOPE_K8S_DEPLOYMENT=sample-workload

# Path on the host to the kubeconfig scripts/generate-observer-kubeconfig.sh
# generated. Never commit the file this points to - it contains a live
# cluster credential.
SCALESCOPE_OBSERVER_KUBECONFIG=./scalescope-observer.kubeconfig

# The observed workload's own /metrics endpoint, reachable from inside the
# container. http://host.docker.internal:18080/metrics assumes a
# `kubectl port-forward -n $SCALESCOPE_K8S_NAMESPACE svc/$SCALESCOPE_K8S_DEPLOYMENT 18080:80`
# running on the host; point this elsewhere if the workload is reachable
# some other way (an Ingress, a NodePort, running ScaleScope in-cluster).
SCALESCOPE_K8S_METRICS_URL=http://host.docker.internal:18080/metrics

# Set to true to let ScaleScope actually write recommended replica counts
# to the cluster (deployments/scale only). Refuses to write if the target
# Deployment already has a HorizontalPodAutoscaler - remove it first
# (`kubectl delete hpa <name> -n $SCALESCOPE_K8S_NAMESPACE`) or the two
# controllers will fight. See README.md's "Actuation" section.
SCALESCOPE_ACTUATE=false
